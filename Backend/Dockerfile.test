# Optimized Dockerfile for testing (no Playwright, uses python:3.12-slim instead)
FROM python:3.12-slim

# Prevent Python from writing .pyc files and force stdout/stderr to be unbuffered
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install only essential system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Upgrade pip first, then install test dependencies (without Playwright)
COPY requirements-test.txt .
RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements-test.txt --resume-retries 3

# Copy application code
COPY . .

EXPOSE 8000
